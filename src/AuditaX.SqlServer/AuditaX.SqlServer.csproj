<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Build Settings -->
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Features>strict</Features>

        <!-- Assembly Info -->
        <AssemblyName>AuditaX.SqlServer</AssemblyName>
        <RootNamespace>AuditaX.SqlServer</RootNamespace>

        <!-- Package Identity -->
        <PackageId>AuditaX.SqlServer</PackageId>
        <Version>2.3.1</Version>
        <AssemblyVersion>2.3.1</AssemblyVersion>
        <FileVersion>2.3.1</FileVersion>
        <Product>AuditaX</Product>

        <!-- Package Metadata -->
        <Title>AuditaX.SqlServer - SQL Server Provider</Title>
        <Authors>jorg3roch4</Authors>
        <Description>SQL Server database provider for AuditaX audit logging with optimized queries and native type support.</Description>
        <Copyright>Copyright (c) 2025 jorg3roch4</Copyright>
        <PackageTags>audit;logging;sqlserver;database;provider;dotnet</PackageTags>
        <PackageReleaseNotes>2.3.1: Republish bump of 2.3.0 (version-only change). Original 2.3.0: SourceReference column widened to NVARCHAR(512). CreateTableSql and GetExpectedTableStructure updated. BREAKING: existing AuditLog tables must ALTER SourceReference to NVARCHAR width &gt;= 512.</PackageReleaseNotes>
        <NeutralLanguage>en</NeutralLanguage>
        <MinClientVersion>6.0</MinClientVersion>

        <!-- Repository & URLs -->
        <PackageProjectUrl>https://github.com/jorg3roch4/AuditaX</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jorg3roch4/AuditaX</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>false</PublishRepositoryUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>

        <!-- Package Assets -->
        <PackageIcon>icon-128x128.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Documentation & Symbols -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>false</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>

        <!-- Build Configuration -->
        <Deterministic>true</Deterministic>
        <EnablePackageValidation>true</EnablePackageValidation>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- Output -->
        <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts</PackageOutputPath>
    </PropertyGroup>

    <!-- Package Assets -->
    <ItemGroup>
        <None Include="../../assets/icon-128x128.png" Pack="true" PackagePath="" />
        <None Include="../../LICENSE" Pack="true" PackagePath="" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <!-- Project References -->
    <ItemGroup>
        <ProjectReference Include="../AuditaX/AuditaX.csproj" />
    </ItemGroup>

    <!-- Dependencies -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    </ItemGroup>
</Project>
